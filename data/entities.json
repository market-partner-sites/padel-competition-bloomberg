reenhouse Sports gives it back.</b></span></p>","type":"HtmlField","savedAsRawHtml":true},"module_id":"","module_heading":"","container_max_width":"960px","content_padding_top":"","module_heading_color":"white","content_padding_bottom":"","background_image_opacity":"","background_image_position":"center center","container_background_color":"#00b094","mobile_content_padding_top":"","mobile_content_padding_bottom":""},"order":4},{"eventId":"tournament_2026","id":"Custom:score:b4c40e8d-0949-4fd0-abc4-60b0d2d776fe","typeId":"Custom:score","categoryId":"Custom:score","subCategoryId":"Custom:score:court_one_score","fields":{"title":"Court 1 - Match 5 score","match_status":"Completed","away_team_points":"21","home_team_points":"10"},"order":4},{"eventId":"tournament_2026","id":"Custom:score:a2e48ce7-f63e-4956-8313-4c2060e99687","typeId":"Custom:score","categoryId":"Custom:score","subCategoryId":"Custom:score:court_two_score","fields":{"title":"Court 2 - Match 5 score","match_status":"Completed","away_team_points":"17","home_team_points":"15"},"order":4},{"eventId":"tournament_2026","id":"Custom:score:a499c752-06e2-47fb-a493-3dab2ca77a23","typeId":"Custom:score","categoryId":"Custom:score","subCategoryId":"Custom:score:court_three_score","fields":{"title":"Court 3 - Match 5 score","match_status":"Completed","away_team_points":"19","home_team_points":"13"},"order":4},{"eventId":"tournament_2026","id":"Custom:score:bf8391a4-7aca-407a-8733-066a4d9ccac5","typeId":"Custom:score","categoryId":"Custom:score","subCategoryId":"Custom:score:knockout_stages_score","fields":{"title":"SF 2 score","match_status":"Completed","away_team_points":"17","home_team_points":"18"},"order":5},{"eventId":"tournament_2026","id":"RegistrationModule:a3a661e3-41ff-49b3-892f-a493a9b22260","typeId":"RegistrationModule","categoryId":"Custom:module","subCategoryId":null,"fields":{"color":"","title":"Registration","module_id":"","submit_text":"Register interest","redirect_url":"","module_heading":"Register 